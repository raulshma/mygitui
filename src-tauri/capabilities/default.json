{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window and panel popouts",
  "windows": [
    "main",
    "popout-*"
  ],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-set-focus",
    "opener:default",
    "dialog:default",
    "process:default",
    "updater:default",
    "deep-link:default",
    "window-state:default"
  ]
}
